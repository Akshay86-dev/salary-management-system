# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

/node_modules

# Ignore npm lock files (optional - uncomment if needed)
# /frontend/package-lock.json

# Ignore Vite build output for API endpoints serving the frontend
/public/vite/

# Ignore cookies/sessions file
cookies.txt

# Ignore log files
/log/*

# Ignore temp files
/tmp/*

# Ignore IDE/editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Ignore OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ignore coverage reports
/coverage
/coverage/*

# Ignore Spring application preloader
/tmp/spring*

# Ignore extra directories
/db/*.sqlite3
/db/*.sqlite3-journal
!/db/schema.rb
!/db/structure.sql

# Ignore seed data files (if any large data files exist)
/db/seeds_data.rb

# Ignore secret credentials
/config/master.key
/config/credentials.yml.enc