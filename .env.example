# Copy this file to .env, replace any example values, and source it in the
# shell before starting Rails. Rails does not load .env automatically.

# Rails/Puma settings
PORT=3000
RAILS_MAX_THREADS=3

# Optional PostgreSQL URL; when unset, config/database.yml uses the local
# salary_management_development database.
# DATABASE_URL=postgresql://localhost/salary_management_development

# Production database settings. Use DATABASE_URL instead if preferred.
# SALARY_MANAGEMENT_DATABASE_PASSWORD=replace-with-database-password

# Production secrets. Do not use these placeholders as real credentials.
# RAILS_MASTER_KEY=replace-with-your-rails-master-key
# DEVISE_JWT_SECRET=replace-with-a-long-random-secret

# Production CORS origins, comma-separated. Development has localhost:5173
# configured in config/initializers/cors.rb.
# CORS_ORIGINS=https://hr.example.com

# Set a strong value before production seeding. In development/test the default
# is password123.
SEED_ADMIN_PASSWORD=change-this-development-password

# Optional production logging and Solid Queue process count.
# RAILS_LOG_LEVEL=info
# JOB_CONCURRENCY=1
